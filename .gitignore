# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# YOLO weights — pulled on first run
*.pt

# Runtime artifacts
snapshots/
logs/
data/
clips/
backups/

# detection.yaml is BOTH shipped defaults AND runtime-mutable state
# (operator polygons, zone edits written via the UI). Two roles, one
# file = git operations can silently clobber runtime state — happened
# Aug 9 when a `git reset --hard` wiped drawn slew polygons. Fix:
# gitignore the actual file; ship `detection.yaml.example` as the
# defaults; each container copies example→real on first startup if
# missing (see src/config_bootstrap.py).
config/detection.yaml

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/
.coverage
htmlcov/
docker-compose.override.yml

# Session-local runtime monitoring artifacts (memory watch loops, etc.)
*-memwatch.log

# Operator's manually-curated clip archive — hundreds of MB of highlight
# clips (baby-rat-drop-fruit, adult-rat-prison-break, etc). Local-only
# reference material, never commit.
clips-manual/

# Per-camera pause sentinels — 0-byte flag files the pipeline reads at
# runtime to toggle individual camera pause state. Ephemeral per-host
# state, not source config.
config/pause_*.flag

# Credentials bucket for anything that doesn't belong in .env. Must stay
# gitignored even when empty so a future `secrets_add` wrapper or manual
# edit never leaks to the repo.
secrets.yaml
