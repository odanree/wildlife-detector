# ── Camera ──────────────────────────────────────────────────────────────────
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1
RTSP_TRANSPORT=tcp
# Multi-thread HEVC/H.264 decode. libavcodec defaults to single-threaded per
# stream when opened via cv2.CAP_FFMPEG; on 4K HEVC sources this caps the
# ingest loop at ~5-6 fps regardless of core count. `threads;0` = auto per
# ffmpeg (uses ncpu). Combine keys with `|`: `rtsp_transport;tcp|threads;0`.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|threads;0

# ── Detection ────────────────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
INFERENCE_THRESHOLD=0.35
INPUT_WIDTH=1280
INPUT_HEIGHT=720
# Rate-limit VLM calls per track (seconds between calls for the same track)
VLM_INTERVAL_S=2.0

# ── VLM backend ──────────────────────────────────────────────────────────────
# claude | ollama | mock
VLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b-v1.6-mistral-q4_K_M

# ── Alerts ───────────────────────────────────────────────────────────────────
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/rodent_detected
HA_TOKEN=

# ── PTZ / slew-to-zone ───────────────────────────────────────────────────────
# Secondary camera slews to the detection zone on a positive rodent event.
# Save PTZ presets in the NVR UI and map zones → presets in config/detection.yaml.
SLEW_ENABLED=false             # master kill-switch; leave false in dev/replay
SECONDARY_CAMERA_ID=1
SLEW_LOCKOUT_SECONDS=10

# PTZ CGI credentials (Amcrest/Dahua). Falls back to AMCREST_* per-camera.
AMCREST_HOST=192.168.1.100
AMCREST_USER=admin
AMCREST_PASS=password
# PTZ_HOST_1=192.168.1.100     # per-camera overrides (0-based index)
# PTZ_CHANNEL_1=2               # NVR channel for secondary camera (default: id+1)
# PTZ_SPEED=4
# PTZ_PORT=80

# ── Replay / test ───────────────────────────────────────────────────────────
VIDEO_PATH=
VIDEO_LOOP=true
VIDEO_SPEED=1.0

# ── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=UTC

# ── Preview server (optional) ────────────────────────────────────────────────
# Set PREVIEW_ENABLED=true (or pass --preview) to expose a live MJPEG feed
# with annotated YOLO/motion/zone overlays at http://localhost:8000/.
# Zero-op when disabled.
PREVIEW_ENABLED=false
PREVIEW_HOST=0.0.0.0
# Default 8100 to avoid clashing with parking-enforcement-detector (port 8000).
PREVIEW_PORT=8100
PREVIEW_EVERY_N=2                # publish every Nth pipeline frame to save encode cost
PREVIEW_ALERT_FLASH_FRAMES=40    # how long a red alert bbox flashes on the preview

# ── Animal-vs-FP classifier (project #137) ──────────────────────────────────
# Post-VLM re-scorer that suppresses low-prob "wildlife detected" alerts
# before they reach the operator. off | shadow | active (default: off).
# In shadow mode we log the prediction but never suppress; in active mode
# we suppress alerts below CLASSIFIER_THRESHOLD on CLASSIFIER_ACTIVE_CAMERAS.
# Fail-open: missing model or missing lightgbm dep degrades to no-op.
CLASSIFIER_MODE=off
CLASSIFIER_THRESHOLD=0.2
# Comma-separated allowlist for active mode. Empty = active mode is a
# no-op for every camera (shadow-only). Roll out per-camera:
#   CLASSIFIER_ACTIVE_CAMERAS=yard        # only yard suppresses
#   CLASSIFIER_ACTIVE_CAMERAS=yard,backyard
CLASSIFIER_ACTIVE_CAMERAS=
# Model file path (inside container). Compose mounts host ./models →
# /app/models-host:ro so the training script's output is picked up
# without a copy step.
CLASSIFIER_MODEL_PATH=/app/models-host/animal_vs_fp.txt
# Persistent shadow log — every classifier prediction (both shadow
# and active modes) is appended to this JSONL. Bind-mounted so
# `docker compose restart` doesn't wipe the audit trail the way it
# does for container stdout logs. Empty = disabled.
CLASSIFIER_SHADOW_LOG_PATH=/app/logs/classifier_shadow.jsonl

# ── Pre-VLM drop shadow log (project #137, debias future training) ──────────
# Sampled JSONL of detections dropped by the insect pre-filter BEFORE
# reaching the VLM. Those rows never land in the alerts table, so the
# current classifier has zero coverage of them. Sink this log so we can
# hand-sample + label a batch to train an unbiased pre-VLM classifier
# later. Empty path = disabled.
PRE_VLM_DROP_LOG_PATH=/app/logs/pre_vlm_drops.jsonl
PRE_VLM_DROP_LOG_SAMPLE=0.05     # 5% sample — cuts I/O on high-motion cams
# Boundary override: drops whose mean brightness falls in this band are
# ALWAYS saved regardless of sample rate — near-threshold rows are the
# highest-value data for a future pre-VLM classifier (most likely to be
# legit animals mis-flagged as insects). Both must be set to enable;
# empty = boundary sampling off.
PRE_VLM_DROP_BOUNDARY_MIN=110
PRE_VLM_DROP_BOUNDARY_MAX=145
# Crop dump: writes the tight bbox as JPEG to <dir>/<camera>/<date>/<ts>_track<id>.jpg
# alongside the JSONL row. Required for hand-labeling — numbers alone
# (mean/max/AR) can't distinguish a moth from a rat. Empty = no crops.
PRE_VLM_DROP_CROP_DIR=/app/logs/pre_vlm_drops

# ── Remote access via Cloudflare Tunnel (optional) ──────────────────────────
# When set, `docker compose --profile remote-access up -d` also brings up
# a `cloudflared` container that opens an outbound tunnel to Cloudflare's
# edge. Public HTTPS URL fronts wildlife-web without any router port-
# forward. Wrap the hostname with Cloudflare Access on the dashboard for
# email-based auth (otherwise the UI is world-open — DO NOT skip that step).
# Get the token from Cloudflare Zero Trust → Networks → Tunnels → your
# tunnel → Configure → Overview → copy the token from the docker command.
# See docker-compose.yml `cloudflared` block for the full setup checklist.
TUNNEL_TOKEN=
